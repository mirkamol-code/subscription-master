# Copy to .env and fill in. Never commit the real .env.

# --- Google sign-in and Gmail access (required) ---------------------------
# OAuth 2.0 "Web application" client from Google Cloud Console (see README).
GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace-me
# Must match an "Authorized redirect URI" on the OAuth client exactly.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/login/oauth2/code/google
# Where the backend sends the browser after Google login (/auth/callback?code=...).
FRONTEND_BASE_URL=http://localhost:5173

# --- Secrets (required) ----------------------------------------------------
# AES-256 key for Google refresh tokens at rest: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=  (generate it, see README "Run and test locally")
# JWT signing secret, at least 32 bytes: openssl rand -base64 48
# JWT_SECRET=  (generate it, see README "Run and test locally")

# --- Database --------------------------------------------------------------
# Local development database (docker-compose-db-only.yml):
POSTGRES_DB=subscription_master_db
POSTGRES_USER=subscription_master
POSTGRES_PASSWORD=change-me
# The app's connection. docker-compose.yml requires all three (in production: Amazon RDS):
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5222/subscription_master_db
SPRING_DATASOURCE_USERNAME=subscription_master
SPRING_DATASOURCE_PASSWORD=change-me

# --- Web Push (optional; push is disabled while these are empty) ----------
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@subscriptionmaster.app

# --- Optional tuning --------------------------------------------------------
# Comma-separated verified Google emails that are granted the ADMIN role when they sign in.
# Grant-only: removing an email never revokes ADMIN; demote admins from the admin panel.
APP_ADMIN_EMAILS=
# Incremental Gmail sync (Spring cron, server time zone Asia/Tashkent).
GMAIL_SYNC_CRON="0 0 */6 * * *"
# Hourly reminder job; reminders go out from REMINDER_HOUR in each user's time zone.
REMINDER_CRON="0 5 * * * *"
REMINDER_HOUR=9
# Hourly status rules (overdue / access end).
STATUS_RULES_CRON="0 15 * * * *"
# Days after a missed due date before a subscription becomes BILLING_REQUIRED.
OVERDUE_GRACE_DAYS=5
# Days before the due date a receipt with an unreadable amount still counts as the renewal.
RENEWAL_WINDOW_DAYS_BEFORE=3
# Largest invoice PDF the app will fetch from Gmail (bytes, default 25 MB).
GMAIL_ATTACHMENT_MAX_BYTES=26214400
# How long to wait for cbu.uz before trying the fallback rate source (open.er-api.com).
CBU_CONNECT_TIMEOUT=5s
CBU_READ_TIMEOUT=10s
# Fallback rate source, used only when cbu.uz fails.
OPEN_ER_API_URL=https://open.er-api.com/v6/latest/USD
OPEN_ER_API_CONNECT_TIMEOUT=5s
OPEN_ER_API_READ_TIMEOUT=10s
# Fetch and save rates when the app starts, so a fresh database has a rate to fall back on.
EXCHANGE_RATES_REFRESH_ON_STARTUP=true
# Demo data for local development only.
APP_SEED_ENABLED=false
